POSTGRES_DB=mawrid_travel
POSTGRES_USER=mawrid
POSTGRES_PASSWORD=replace-with-a-local-password

# Optional initial Admin account. Use a unique, strong password outside development.
ADMIN_SEED_ENABLED=false
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=replace-with-a-strong-admin-password
ADMIN_SEED_FIRST_NAME=Mawrid
ADMIN_SEED_LAST_NAME=Admin

# Optional Cloudflare R2 storage for product images.
R2__AccountId=your-cloudflare-account-id
R2__AccessKeyId=your-r2-access-key-id
R2__SecretAccessKey=your-r2-secret-access-key
R2__BucketName=your-r2-bucket-name
R2__PublicBaseUrl=https://images.example.com
